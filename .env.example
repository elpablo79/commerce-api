# Copy this file to .env and adjust the values.
PORT=4000
DATABASE_URL=postgres://commerce:commerce@localhost:5432/commerce
# Optional: enables the catalog cache and a shared rate-limit store. Remove it to run without Redis.
REDIS_URL=redis://localhost:6379
# Use a long random string, for example: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters

# Payments: "mock" works offline; "stripe" needs the two keys below (and is required in production).
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_SECRET=dev-only-mock-webhook-secret
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Optional
# CORS_ORIGINS=http://localhost:3000,https://shop.example.com
# ORDER_EXPIRY_MINUTES=30
# CATALOG_CACHE_TTL_SECONDS=15
# TRUST_PROXY=1
# LOG_LEVEL=info

# Used only by `npm test` (the database must end with _test, Redis must not be database 0)
# TEST_DATABASE_URL=postgres://commerce:commerce@localhost:5432/commerce_test
# TEST_REDIS_URL=redis://localhost:6379/15
