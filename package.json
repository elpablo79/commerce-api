{
  "name": "commerce-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "migrate": "tsx --env-file=.env scripts/migrate.ts",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "mock:pay": "tsx --env-file=.env scripts/mock-pay.ts",
    "demo": "tsx --env-file=.env scripts/demo.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.24.6",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "rate-limit-redis": "^6.0.2",
    "stripe": "^23.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^3.2.7",
    "supertest": "^7.3.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
